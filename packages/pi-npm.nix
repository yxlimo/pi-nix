{
  lib,
  stdenv,
  nodejs_22,
  fetchurl,
  importNpmLock,
  makeWrapper,
  fd,
  ripgrep,
  wl-clipboard,
  xclip,
  runCommandLocal,
  # 拉包用的 registry。默认是官方 npm —— 本仓面向全球使用；
  # 国内机器由 consumer 传镜像，例如：
  #   (pi-nix.packages.x86_64-linux.pi-npm).override {
  #     registry = "https://registry.npmmirror.com";
  #   }
  # 换源不会改变哈希：镜像与官方是同一份 tarball（实测 1.5.0 的
  # dist.shasum 与 integrity 两边逐字节相同）；若哪天不一致，
  # fetchurl 的哈希与 lock 里的 integrity 会让构建直接失败，
  # 不会静默装进一份不同的代码。
  registry ? "https://registry.npmjs.org",
}:

# pi built from the published npm tarball.
#
# This is the second of two installation paths in this repository. It needs no
# source checkout and no TypeScript build, so it cannot be broken by the model
# catalog's type coupling that makes the source build fail when a provider has
# no classifier entries.
#
# The version and tarball hash live in flake.nix, which CI keeps in sync with
# upstream releases. The install lockfile in npm/ is generated by
# scripts/gen-npm-lock.py from the same release.

let
  version = "1.5.0";

  # 去掉可能的尾斜杠，否则会拼出 `//@earendil-works/...`
  reg = lib.removeSuffix "/" registry;

  src = fetchurl {
    url = "${reg}/@earendil-works/pi-coding-agent/-/pi-coding-agent-${version}.tgz";
    hash = "sha256-W/tmhIpMS4HGN86NITa+AZRbcKrI6FVrCRywIkGzhd8=";
  };

  # 依赖树来自 npm/package-lock.json，而那份 lock 里 122 条 "resolved" 全指向
  # registry.npmjs.org —— 只换 tarball 的源不够，依赖还是会从官方拉。
  # 所以在构建期把 lock 的 host 改掉；用默认 registry 时原样拷贝。
  # integrity 字段不动：镜像给的包若与官方不同，npm 会自己校验失败。
  npmRoot = runCommandLocal "pi-npm-root" { } ''
    mkdir -p $out
    cp ${../npm/package.json} $out/package.json
    ${
      lib.optionalString (reg != "https://registry.npmjs.org") ''
        sed 's|https://registry.npmjs.org|${reg}|g' ${../npm/package-lock.json} > $out/package-lock.json
      ''
    }
    ${
      lib.optionalString (reg == "https://registry.npmjs.org") ''
        cp ${../npm/package-lock.json} $out/package-lock.json
      ''
    }
  '';
in
stdenv.mkDerivation {
  pname = "pi-npm";
  inherit version src;

  # The npm tarball ships compiled output only. Dependencies still have to be
  # fetched, and they come from the generated lockfile.
  npmDeps = importNpmLock {
    npmRoot = npmRoot;
  };

  nativeBuildInputs = [
    nodejs_22
    makeWrapper
    importNpmLock.npmConfigHook
  ];

  # Everything is prebuilt: just link the dependency tree into place.
  dontBuild = true;
  dontStrip = true;
  dontPatchShebangs = true;

  installPhase = ''
    runHook preInstall

    # Keep the package under node_modules/<name> so pi's runtime can resolve
    # its own dependencies by bare specifier (the bundler emits requires for
    # jiti and friends).
    pkgdir="$out/lib/node_modules/@earendil-works/pi-coding-agent"
    mkdir -p "$out/lib/node_modules/@earendil-works" "$out/bin"

    # The npm tarball unpacks to the source root and npmConfigHook installed
    # node_modules beside it. Copy both, but not the copy of this very package
    # that node_modules holds as a dependency — link it back to the parent
    # instead, which is what npm's own layout does.
    cp -R . "$pkgdir"
    rm -rf "$pkgdir/node_modules/@earendil-works/pi-coding-agent"
    ln -s ../.. "$pkgdir/node_modules/@earendil-works/pi-coding-agent"

    # Node goes on PATH so pi can find npm for package installs, and is
    # appended so shells started by the bash tool keep the user's own node.
    # fd, ripgrep and the clipboard tools are pi's own dependencies and take
    # precedence over whatever the user has. Same composition as upstream's
    # nix/package.nix wrapper.
    makeWrapper ${nodejs_22}/bin/node "$out/bin/pi" \
      --add-flags "$pkgdir/dist/bundle/cli.js" \
      --suffix PATH : ${lib.makeBinPath [ nodejs_22 ]} \
      --prefix PATH : ${
        lib.makeBinPath (
          [
            fd
            ripgrep
          ]
          ++ lib.optionals stdenv.hostPlatform.isLinux [
            wl-clipboard
            xclip
          ]
        )
      }

    runHook postInstall
  '';

  meta = {
    description = "pi coding agent (prebuilt npm bundle)";
    homepage = "https://pi.dev";
    license = lib.licenses.mit;
    mainProgram = "pi";
    platforms = lib.platforms.unix;
  };
}
