{
  lib,
  stdenv,
  nodejs_22,
  fetchurl,
  importNpmLock,
  makeWrapper,
}:

# pi built from the published npm tarball.
#
# This is the second of two installation paths in this repository. It needs no
# source checkout and no TypeScript build, so it cannot be broken by the model
# catalog's type coupling that makes the source build fail when a provider has
# no classifier entries.
#
# The version and tarball hash live in flake.nix, which CI keeps in sync with
# upstream releases. The install lockfile in npm/ is generated by
# scripts/gen-npm-lock.py from the same release.

let
  version = "1.5.0";

  src = fetchurl {
    url = "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-${version}.tgz";
    hash = "sha256-W/tmhIpMS4HGN86NITa+AZRbcKrI6FVrCRywIkGzhd8=";
  };
in
stdenv.mkDerivation {
  pname = "pi-npm";
  inherit version src;

  # The npm tarball ships compiled output only. Dependencies still have to be
  # fetched, and they come from the generated lockfile.
  npmDeps = importNpmLock {
    npmRoot = ../npm;
  };

  nativeBuildInputs = [
    nodejs_22
    makeWrapper
    importNpmLock.npmConfigHook
  ];

  # Everything is prebuilt: just link the dependency tree into place.
  dontBuild = true;
  dontStrip = true;
  dontPatchShebangs = true;

  installPhase = ''
    runHook preInstall

    # Keep the package under node_modules/<name> so pi's runtime can resolve
    # its own dependencies by bare specifier (the bundler emits requires for
    # jiti and friends).
    pkgdir="$out/lib/node_modules/@earendil-works/pi-coding-agent"
    mkdir -p "$out/lib/node_modules/@earendil-works" "$out/bin"

    # The npm tarball unpacks to the source root and npmConfigHook installed
    # node_modules beside it, so a single copy brings both.
    cp -R . "$pkgdir"

    makeWrapper ${nodejs_22}/bin/node "$out/bin/pi" \
      --add-flags "$out/lib/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"

    runHook postInstall
  '';

  meta = {
    description = "pi coding agent (prebuilt npm bundle)";
    homepage = "https://pi.dev";
    license = lib.licenses.mit;
    mainProgram = "pi";
    platforms = lib.platforms.unix;
  };
}
